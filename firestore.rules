rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isGoogleUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == "google.com";
    }

    function isAllowedUser() {
      return isGoogleUser()
        && request.auth.uid in [
          "056LHaaeFKYeqYCvNRUwbmww8AH3",
          "sGuYhgdQswdtlhCTTfizJQDhNiF3"
        ];
    }

    function isOwner(userId) {
      return isAllowedUser()
        && request.auth.uid == userId;
    }

    match /users/{userId}/projects/{documentId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/categories/{documentId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/statuses/{documentId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/technologies/{documentId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/domains/{documentId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/pendingItems/{documentId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/meta/{documentId} {
      allow read, write: if isOwner(userId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
