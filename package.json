{
  "name": "eslavahub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "firebase emulators:start --only hosting",
    "lint": "eslint public/js",
    "format": "prettier --write \"**/*.{js,json,md,css,html}\"",
    "format:check": "prettier --check \"**/*.{js,json,md,css,html}\"",
    "check": "npm run lint && npm run format:check",
    "build": "npm run check"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "firebase-tools": "^14.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0"
  }
}
